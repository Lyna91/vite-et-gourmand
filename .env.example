MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=vite_gourmand
MYSQL_USER=user_one
MYSQL_PASSWORD=

MONGO_ROOT_USER=mongo_user_one
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=vite_gourmand_stats


# Port du site sur la machine : 8080 en local, 80 sur le serveur
HTTP_PORT=8080
# Réglages PHP : development en local (erreurs affichées), production sur le serveur (erreurs masquées)
PHP_ENV=development


# Envoi des mails (en local : Mailpit, qui attrape tout)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=contact@vite-et-gourmand.test
MAIL_CONTACT=contact@vite-et-gourmand.test

# Adresse du site, pour les liens envoyés par mail
APP_URL=http://localhost:8080